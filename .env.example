# Copy to .env and fill in your own values.
# Never commit .env.
# All values below are descriptive placeholders only.

# Database
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/agri_intelligence

# Cache / queue
REDIS_URL=redis://localhost:6379/0

# Google Gemini API key
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Gemini model IDs
# Set these to the exact model IDs shown in Google AI Studio.
# Do not guess an ID.
# The values below are placeholders, not valid model IDs.
# The code must read them from these variables instead of hard-coding a model name.
GEMINI_MODEL_FLASH=YOUR_GEMINI_FLASH_MODEL_ID
GEMINI_MODEL_PRO=YOUR_GEMINI_PRO_MODEL_ID

# SMS provider
SMS_PROVIDER_KEY=PASTE_YOUR_SMS_PROVIDER_API_KEY_HERE

# Weather provider
WEATHER_API_KEY=PASTE_YOUR_WEATHER_API_KEY_HERE

# Payment provider
# bKash / Nagad via aggregator
PAYMENT_PROVIDER_KEY=PASTE_YOUR_PAYMENT_PROVIDER_API_KEY_HERE
PAYMENT_WEBHOOK_SECRET=PASTE_YOUR_PAYMENT_WEBHOOK_SECRET_HERE

# Object storage
OBJECT_STORAGE_BUCKET=YOUR_STORAGE_BUCKET_NAME_HERE

# Error tracking
# Optional
SENTRY_DSN=PASTE_YOUR_SENTRY_DSN_HERE

# OTP signing secret
# Generate a long random string for local use
OTP_SECRET=GENERATE_A_LONG_RANDOM_STRING_HERE
